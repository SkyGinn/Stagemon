<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовый стиль для всех диалогов -->
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Dialog"> -->
        <!-- Фон диалога -->
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <!-- Заголовок -->
        <item name="android:titleTextAppearance">@style/CustomDialogTitle</item>
        <!-- Текст сообщения -->
        <item name="android:textAppearance">@style/CustomDialogText</item>
        <!-- Кнопки -->
        <item name="buttonBarButtonStyle">@style/CustomDialogButton</item>
        <!-- Цвет кнопок -->
        <item name="colorAccent">#FF1E1E1E</item>
        <!-- Отступы -->
        <item name="android:padding">16dp</item>
    </style>

    <!-- Стиль для диалога метронома - принудительный ландшафт -->
    <style name="MetronomeDialogTheme" parent="CustomDialogTheme">
        <item name="android:screenOrientation">landscape</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Стиль заголовка -->
    <style name="CustomDialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Стиль текста -->
    <style name="CustomDialogText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Стиль кнопок -->
    <style name="CustomDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@null</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>