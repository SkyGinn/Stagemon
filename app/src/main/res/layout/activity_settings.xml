<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FF1E1E1E">

    <!-- ========== ЗАГОЛОВОК ========== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙ USB Audio Settings ⚙"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        app:fontFamily="@font/myfont" />

    <!-- ========== СТАТУС И ИНФО ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FF252525"
        android:padding="2dp"
        android:layout_marginBottom="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB:"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />
            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No device"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="end"
            android:singleLine="true"
            android:layout_marginEnd="8dp" />

        <!-- НОВАЯ КНОПКА INFO -->
        <Button
            android:id="@+id/btnDeviceInfo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:backgroundTint="#FF444444"
            android:text="ℹ"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:padding="0dp"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <!-- ========== ДВЕ КОЛОНКИ ГОРИЗОНТАЛЬНО ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ЛЕВАЯ КОЛОНКА: OUTPUT FORMAT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OUTPUT FORMAT"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                app:fontFamily="@font/myfont" />

            <!-- Sample Rate (заблокирован) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Sample Rate:"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    app:fontFamily="@font/myfont" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="48000 Hz (Fixed)"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    app:fontFamily="@font/myfont" />
            </LinearLayout>

            <!-- Bit Depth + Кнопка теста мелодии -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Bit Depth:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:fontFamily="@font/myfont" />
                <Spinner
                    android:id="@+id/spinnerBitDepth"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#FF333333"
                    android:paddingHorizontal="8dp" />
                <FrameLayout
                    android:id="@+id/containerTestMelody"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_button">

                    <ImageButton
                        android:id="@+id/btnTestMelody"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_play"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="Test bit depth" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ВЕРТИКАЛЬНЫЙ РАЗДЕЛИТЕЛЬ -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#FF444444"
            android:layout_marginHorizontal="8dp" />

        <!-- ПРАВАЯ КОЛОНКА: CHANNEL ROUTING -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CHANNEL ROUTING"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                app:fontFamily="@font/myfont" />

            <!-- FOH Left -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="FOH L:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:fontFamily="@font/myfont" />
                <Spinner
                    android:id="@+id/spinnerFohL"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="#FF333333"
                    android:paddingHorizontal="8dp" />
                <FrameLayout
                    android:id="@+id/containerTestFohL"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_button">

                    <ImageButton
                        android:id="@+id/btnTestFohL"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_play"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="Test FOH Left" />
                </FrameLayout>
            </LinearLayout>

            <!-- FOH Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="FOH R:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:fontFamily="@font/myfont" />
                <Spinner
                    android:id="@+id/spinnerFohR"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="#FF333333"
                    android:paddingHorizontal="8dp" />
                <FrameLayout
                    android:id="@+id/containerTestFohR"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_button">

                    <ImageButton
                        android:id="@+id/btnTestFohR"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_play"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="Test FOH Right" />
                </FrameLayout>
            </LinearLayout>

            <!-- MON Left -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="MON L:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:fontFamily="@font/myfont" />
                <Spinner
                    android:id="@+id/spinnerMonL"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="#FF333333"
                    android:paddingHorizontal="8dp" />
                <FrameLayout
                    android:id="@+id/containerTestMonL"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_button">

                    <ImageButton
                        android:id="@+id/btnTestMonL"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_play"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="Test MON Left" />
                </FrameLayout>
            </LinearLayout>

            <!-- MON Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="MON R:"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:fontFamily="@font/myfont" />
                <Spinner
                    android:id="@+id/spinnerMonR"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="#FF333333"
                    android:paddingHorizontal="8dp" />
                <FrameLayout
                    android:id="@+id/containerTestMonR"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_rounded_button">

                    <ImageButton
                        android:id="@+id/btnTestMonR"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_play"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="Test MON Right" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>